      {"username": "OpenAIDevs", "company": "OpenAI", "enabled": true},
      {"username": "AnthropicAI", "company": "Anthropic", "enabled": true},
      {"username": "GoogleDeepMind", "company": "Google DeepMind", "enabled": true},
